# https://vercel.com/marketplace/neon — wordt automatisch gezet als je Neon aan het project koppelt
POSTGRES_URL=

# Het gedeelde wachtwoord voor Tom en Quirijn. Leeg laten = geen inlogscherm.
IM_PASSWORD=

# Garmin via intervals.icu — per persoon. Sleutel: intervals.icu → Settings → Developer Settings.
# Athlete-ID is optioneel (standaard "0" = eigenaar van de sleutel).
ICU_TOM_API_KEY=
ICU_TOM_ATHLETE_ID=
ICU_QUIRIJN_API_KEY=
ICU_QUIRIJN_ATHLETE_ID=

# Laat de dagelijkse Vercel Cron /api/sync aanroepen zonder inlogcookie. Willekeurige lange string.
CRON_SECRET=
